---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <header class="border-border border-b py-10 sm:py-14">
      <p class="eyebrow mb-4">Personal notes by {config.site.author}</p>
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <h1
            class="max-w-3xl text-4xl leading-tight font-semibold sm:text-5xl"
          >
            Molecules, data, and code.
          </h1>
          <p
            class="text-muted-foreground mt-4 max-w-2xl text-lg leading-relaxed"
          >
            Working notes on practical cheminformatics, molecular data, and
            reproducible computational workflows.
          </p>
        </div>
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="text-muted-foreground hover:text-accent inline-flex shrink-0 items-center gap-2 font-mono text-sm"
          aria-label="RSS feed"
        >
          <IconRss width={18} height={18} class="stroke-current stroke-2" />
          RSS feed
        </a>
      </div>
    </header>

    <section class="py-10 sm:py-12" aria-labelledby="posts-heading">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 id="posts-heading" class="text-2xl font-semibold">Latest notes</h2>
        <span class="text-muted-foreground font-mono text-xs">
          {
            `${sortedPosts.length} ${sortedPosts.length === 1 ? "entry" : "entries"}`
          }
        </span>
      </div>
      <ul>
        {sortedPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
